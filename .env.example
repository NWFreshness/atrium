# Neon Postgres connection string (postgresql://...)
DATABASE_URL=
# AUTH_SECRET is required for Auth.js JWT sessions.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_OWNER_EMAIL=
AUTH_OWNER_PASSWORD=
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=
# Phase 6: only the literal string "true" opens /signup. Anything else is closed.
# e2e: the open-signup journeys in e2e/accounts.spec.ts need it in the runner's
# environment (Playwright passes its env to the dev server it starts), for example
#   AUTH_SIGNUP_ENABLED=true npx playwright test
# Without it those two tests skip and the closed state is asserted instead. If a dev
# server is already running, Playwright reuses it and that server's env wins.
AUTH_SIGNUP_ENABLED=
